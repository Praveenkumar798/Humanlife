# =============================================================================
# Human Legacy AI - Environment Variables Template
# Copy this file to .env before starting the stack
# =============================================================================

# --- Database ---
POSTGRES_USER=humanlegacy
POSTGRES_PASSWORD=humanlegacy_dev_pass
POSTGRES_DB=humanlegacy_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://humanlegacy:humanlegacy_dev_pass@localhost:5432/humanlegacy_db
DATABASE_URL_SYNC=postgresql+psycopg2://humanlegacy:humanlegacy_dev_pass@localhost:5432/humanlegacy_db

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-very-long-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Google Gemini API ---
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Vector & RAG Parameters ---
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# --- File Upload Limits ---
MAX_UPLOAD_SIZE_MB=50

# --- App Mode ---
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
