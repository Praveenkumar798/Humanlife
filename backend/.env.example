# =============================================================================
# Human Legacy AI - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://humanlegacy:your_db_password_here@localhost:5432/humanlegacy_db
DATABASE_URL_SYNC=postgresql+psycopg2://humanlegacy:your_db_password_here@localhost:5432/humanlegacy_db
POSTGRES_USER=humanlegacy
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=humanlegacy_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT Authentication ---
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# --- Embedding Configuration ---
# text-embedding-004 outputs 768 dimensions
EMBEDDING_DIMENSIONS=768

# --- RAG Configuration ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Application ---
APP_ENV=development
APP_DEBUG=true

